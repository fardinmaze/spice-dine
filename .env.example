# Where the contact form POSTs JSON. Leave empty to simulate a successful send (draft mode).
VITE_CONTACT_ENDPOINT=

# Where the catering enquiry form POSTs JSON. Falls back to VITE_CONTACT_ENDPOINT when empty.
VITE_CATERING_ENDPOINT=

# Shows the "Draft — placeholder content" badge. Set to false (or remove) for launch.
VITE_SHOW_DRAFT_BADGE=true
